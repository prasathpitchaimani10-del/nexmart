# ==========================================
# NEXMART PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your secret credentials.
# Do NOT commit .env to source control repositories.
# ==========================================

# BACKEND CONFIGURATION
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nexmart_db?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_encryption_key_here_min_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:3000

# CLOUDINARY MEDIA ASSETS
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# PAYMENT GATEWAY SANDBOX
PAYMENT_PROVIDER_KEY=test_key_sandbox_gateway_nexmart
PAYMENT_PROVIDER_SECRET=test_secret_sandbox_gateway_nexmart
PAYMENT_WEBHOOK_SECRET=test_webhook_signing_secret

# NOTIFICATION / SMTP MAILER
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password

# FRONTEND CONFIGURATION
# In production on Render, set this to your deployed backend URL: https://your-backend.onrender.com/api
# In local development, defaults to /api (served via integrated full-stack server)
VITE_API_BASE_URL=
